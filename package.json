{
  "name": "mobile-barcode-inventory",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "description": "Offline barcode inventory counts for iOS and Android: a one-scan EAN-13 gate, manual fallback and discrepancy review. Expo SDK 57, React Native, strict TypeScript and SQLite.",
  "author": "Folder IT (https://folderit.net)",
  "homepage": "https://github.com/FolderITDev/mobile-barcode-inventory#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FolderITDev/mobile-barcode-inventory.git"
  },
  "bugs": {
    "url": "https://github.com/FolderITDev/mobile-barcode-inventory/issues"
  },
  "dependencies": {
    "@expo-google-fonts/barlow": "^0.4.1",
    "@expo-google-fonts/barlow-condensed": "^0.4.1",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "expo": "~57.0.26",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client --port 8083",
    "android": "expo run:android --port 8083",
    "ios": "expo run:ios --port 8083",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "format": "prettier --write src tests *.json *.js",
    "format:check": "prettier --check src tests *.json *.js"
  },
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  }
}
